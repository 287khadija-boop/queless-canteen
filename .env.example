# ============================================================
# Quesless Campus - Environment Configuration
# Malla Reddy Engineering College for Women (MRECW)
# ============================================================

# Application Runtime
PORT=3000
NODE_ENV=development

# Campus Operational Configuration
CAMPUS_NAME="Malla Reddy Engineering College for Women"
CANTEEN_TIMEZONE="Asia/Kolkata"
CANTEEN_OPEN_TIME="09:00"
CANTEEN_CLOSE_TIME="16:00"

# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key (safe for browser and backend verification)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role Key (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Payment Gateway Configuration (Sandbox / Production)
# Provider options: sandbox | razorpay
PAYMENT_PROVIDER=sandbox
PAYMENT_PROVIDER_KEY_ID=rzp_test_placeholder_key_id
PAYMENT_PROVIDER_KEY_SECRET=placeholder_secret_key
PAYMENT_WEBHOOK_SECRET=placeholder_webhook_secret

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN="http://localhost:3000"
